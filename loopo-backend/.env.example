# Copy this file to .env and configure the variables

PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/loopo_db?schema=public"

# Redis Connection
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Secret Keys (Replace with long random strings in production)
JWT_ACCESS_SECRET="enterprise_jwt_access_secret_key_change_me_in_prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="enterprise_jwt_refresh_secret_key_change_me_in_prod"
JWT_REFRESH_EXPIRATION="30d"

# Google OAuth Setup
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Apple OAuth Setup
APPLE_CLIENT_ID="com.yourcompany.auth"
APPLE_TEAM_ID="YOURTEAMID"
APPLE_KEY_ID="YOURKEYID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOURPRIVATEKEY\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/apple/callback"

# Global Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS: comma-separated list of allowed frontend origins, e.g.
# "https://loopo.example.com,https://admin.loopo.example.com"
# Leave unset to reflect any Origin (current default - see main.ts for why
# this is safe today but should still be scoped once the real deployed
# frontend origins are known).
CORS_ALLOWED_ORIGINS=

# AWS S3 Configuration
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_BUCKET_NAME="loopo-marketplace"
S3_REGION="us-east-1"
