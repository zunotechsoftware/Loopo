  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

// --- NEW PAYMENTS & SUBSCRIPTIONS MODELS ---

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum SubscriptionDuration {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FeaturedType {
  HOMEPAGE
  CATEGORY
  SEARCH
  BADGE
}

enum TransactionType {
  CHARGE
  REFUND
  CHARGEBACK
}

model PaymentProvider {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  code        String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  payments    Payment[]

  @@map("payment_providers")
}

model SubscriptionPlan {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  description         String?
  price               Float
  currency            String               @default("INR")
  duration            SubscriptionDuration
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?

  features            SubscriptionFeature?
  subscriptions       Subscription[]
  userSubscriptions   UserSubscription[]

  @@map("subscription_plans")
}

model SubscriptionFeature {
  id               String           @id @default(uuid()) @db.Uuid
  planId           String           @unique @db.Uuid
  maxListings      Int              @default(5)
  featuredListings Int              @default(0)
  boostCredits     Int              @default(0)
  imageLimits      Int              @default(5)
  videoUpload      Boolean          @default(false)
  prioritySupport  Boolean          @default(false)
  analyticsAccess  Boolean          @default(false)
  chatLimits       Int              @default(100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("subscription_features")
}

model Subscription {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @db.Uuid
  planId                 String           @db.Uuid
  status                 String
  provider               String
  providerSubscriptionId String?          @unique
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean          @default(false)
  canceledAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments               Payment[]
  userSubscriptions      UserSubscription[]

  @@index([userId])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

model UserSubscription {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  subscriptionId   String?          @db.Uuid
  planId           String           @db.Uuid
  maxListings      Int
  featuredListings Int
  boostCredits     Int
  imageLimits      Int
  videoUpload      Boolean          @default(false)
  prioritySupport  Boolean          @default(false)
  analyticsAccess  Boolean          @default(false)
  chatLimits       Int
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model FeaturedPackage {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  price        Float
  currency     String       @default("INR")
  durationDays Int
  type         FeaturedType
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  payments     Payment[]

  @@map("featured_packages")
}

model BoostPackage {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  price          Float
  currency       String      @default("INR")
  durationDays   Int
  creditAmount   Int         @default(1)
  priorityRanking Int         @default(1)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  payments       Payment[]
  userBoosts     UserBoost[]

  @@map("boost_packages")
}

model UserBoost {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  packageId      String       @db.Uuid
  creditsGranted Int
  creditsUsed    Int          @default(0)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package        BoostPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_boosts")
}

model Coupon {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  name           String
  type           CouponType
  value          Float
  minPurchase    Float?             @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usageCount     Int                @default(0)
  perUserLimit   Int                @default(1)
  expiresAt      DateTime?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  payments       Payment[]
  redemptions    CouponRedemption[]

  @@index([code])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  paymentId String?  @db.Uuid
  redeemedAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, couponId, paymentId])
  @@map("coupon_redemptions")
}

model Payment {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  providerId           String            @db.Uuid
  subscriptionId       String?           @db.Uuid
  featuredPackageId    String?           @db.Uuid
  boostPackageId       String?           @db.Uuid
  productId            String?           @db.Uuid
  amount               Float
  currency             String            @default("INR")
  status               PaymentStatus     @default(PENDING)
  providerPaymentId    String?           @unique
  providerOrderId      String?           @unique
  metadata             Json?
  description          String?
  couponId             String?           @db.Uuid
  discountAmount       Float             @default(0)
  netAmount            Float
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             PaymentProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subscription         Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  featuredPackage      FeaturedPackage?  @relation(fields: [featuredPackageId], references: [id], onDelete: SetNull)
  boostPackage         BoostPackage?     @relation(fields: [boostPackageId], references: [id], onDelete: SetNull)
  product              Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  coupon               Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  transactions         PaymentTransaction[]
  refunds              Refund[]
  redemptions          CouponRedemption[]

  @@index([userId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentTransaction {
  id                  String          @id @default(uuid()) @db.Uuid
  paymentId           String          @db.Uuid
  transactionType     TransactionType @default(CHARGE)
  amount              Float
  status              String
  providerTransactionId String?
  rawResponse         Json?
  createdAt           DateTime        @default(now())

  payment             Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentId        String       @db.Uuid
  amount           Float
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique
  rawResponse      Json?
  createdById      String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("AdminRefunds", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

model PaymentWebhook {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String?
  eventType       String
  payload         Json
  status          String    @default("PENDING")
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, providerEventId])
  @@map("payment_webhooks")
}

model PaymentAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payment_audit_logs")
}

// --- NEW REPORTS & MODERATION MODELS ---

enum ReportTargetType {
  LISTING
  USER
  CHAT_MESSAGE
  CATEGORY
  SYSTEM
}

enum ReportStatus {
  OPEN
  ASSIGNED
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
  CLOSED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationActionType {
  WARN_USER
  SUSPEND_USER
  BAN_USER
  HIDE_LISTING
  DELETE_LISTING
  SUSPEND_LISTING
  RESTORE_LISTING
  RESTORE_USER
  DELETE_MESSAGE
  ESCALATE
}

model ReportReason {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  label       String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reports     Report[]

  @@map("report_reasons")
}

model Report {
  id            String           @id @default(uuid()) @db.Uuid
  reporterId    String           @db.Uuid
  targetType    ReportTargetType
  targetId      String
  reasonCode    String
  customReason  String?
  details       String
  status        ReportStatus     @default(OPEN)
  priority      PriorityLevel    @default(MEDIUM)
  caseId        String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  reporter      User             @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reason        ReportReason     @relation(fields: [reasonCode], references: [code], onDelete: Restrict)
  case          ModerationCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  evidence      ReportEvidence[]

  @@index([reporterId])
  @@index([targetId])
  @@index([status])
  @@map("reports")
}

model ReportEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @db.Uuid
  type        String
  fileUrl     String?
  textNotes   String?
  createdAt   DateTime @default(now())

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_evidence")
}

model ModerationCase {
  id                 String           @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  status             ReportStatus     @default(OPEN)
  priority           PriorityLevel    @default(MEDIUM)
  assignedModeratorId String?         @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  assignedModerator  User?            @relation("ModeratorUser", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  reports            Report[]
  actions            ModerationAction[]
  notes              ModerationNote[]
  assignments        CaseAssignment[]

  @@index([assignedModeratorId])
  @@map("moderation_cases")
}

model CaseAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @db.Uuid
  moderatorId  String   @db.Uuid
  assignedById String   @db.Uuid
  assignedAt   DateTime @default(now())

  case         ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderator    User           @relation("CaseModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  assignedBy   User           @relation("CaseAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@map("case_assignments")
}

model ModerationNote {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @db.Uuid
  moderatorId  String   @db.Uuid
  note         String
  createdAt    DateTime @default(now())

  case         ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  moderator    User           @relation("ModeratorNotes", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@map("moderation_notes")
}

model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  caseId       String?              @db.Uuid
  moderatorId  String               @db.Uuid
  actionType   ModerationActionType
  targetType   String
  targetId     String
  reason       String
  createdAt    DateTime             @default(now())

  case         ModerationCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  moderator    User                 @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@map("moderation_actions")
}

model BlockedContent {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  targetId     String   @unique
  reason       String
  blockedById  String   @db.Uuid
  createdAt    DateTime @default(now())

  blockedBy    User     @relation("BlockedByAdmin", fields: [blockedById], references: [id], onDelete: Cascade)

  @@map("blocked_content")
}

model WarningHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  caseId      String?  @db.Uuid
  reason      String
  warnedById  String   @db.Uuid
  createdAt   DateTime @default(now())

  user        User     @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  warnedBy    User     @relation("AdminWarnings", fields: [warnedById], references: [id], onDelete: Cascade)

  @@map("warning_history")
}

model UserStrike {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  strikeCount Int      @default(1)
  reason      String
  caseId      String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserStrikes", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_strikes")
}

// --- REVIEWS, RATINGS, REPUTATION & TRUST SCORE MODELS ---

enum ReviewType {
  SELLER_REVIEW
  BUYER_REVIEW
  PRODUCT_REVIEW
  TRANSACTION_REVIEW
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  reviewerId      String       @db.Uuid
  targetUserId    String?      @db.Uuid
  productId       String?      @db.Uuid
  paymentId       String?      @db.Uuid
  reviewType      ReviewType
  title           String?
  content         String
  isVerified      Boolean      @default(false)
  isVisible       Boolean      @default(true)
  editableUntil   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  reviewer        User         @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUser      User?        @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  ratings         ReviewRating[]
  reactions       ReviewReaction[]

  @@unique([reviewerId, productId, reviewType])
  @@index([targetUserId])
  @@index([productId])
  @@index([reviewType])
  @@map("reviews")
}

model ReviewRating {
  id                  String   @id @default(uuid()) @db.Uuid
  reviewId            String   @unique @db.Uuid
  overall             Int
  communication       Int?
  responseTime        Int?
  productAccuracy     Int?
  deliveryExperience  Int?
  behaviour           Int?
  valueForMoney       Int?
  wouldRecommend      Boolean?
  createdAt           DateTime @default(now())

  review              Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_ratings")
}

model ReviewReaction {
  id         String   @id @default(uuid()) @db.Uuid
  reviewId   String   @db.Uuid
  userId     String   @db.Uuid
  type       String
  createdAt  DateTime @default(now())

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId, type])
  @@map("review_reactions")
}

model SellerStatistics {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  averageRating    Float    @default(0)
  totalReviews     Int      @default(0)
  positivePercent  Float    @default(0)
  negativePercent  Float    @default(0)
  recentTrend      Float    @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation("SellerStats", fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_statistics")
}

model BuyerStatistics {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  averageRating    Float    @default(0)
  totalReviews     Int      @default(0)
  positivePercent  Float    @default(0)
  negativePercent  Float    @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation("BuyerStats", fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_statistics")
}

model ReputationScore {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  sellerScore      Float    @default(0)
  buyerScore       Float    @default(0)
  overallScore     Float    @default(0)
  verifiedBadge    Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user             User     @relation("ReputationScore", fields: [userId], references: [id], onDelete: Cascade)

  @@map("reputation_scores")
