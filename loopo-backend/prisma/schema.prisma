datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

enum Provider {
  LOCAL
  GOOGLE
  APPLE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String?     @unique
  phone            String?     @unique
  password         String?
  firstName        String?
  lastName         String?
  profileImage     String?
  isEmailVerified  Boolean     @default(false)
  isPhoneVerified  Boolean     @default(false)
  status           UserStatus  @default(PENDING)
  provider         Provider    @default(LOCAL)
  providerId       String?     @unique
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  phoneOtps               PhoneOtp[]
  sessions                Session[]
  profile                 Profile?
  addresses               Address[]
  notificationSettings    NotificationSetting?
  kycDocuments            KycDocument[]
  auditLogs               AuditLog[]
  mediaFiles              MediaFile[]
  products                Product[]
  statusHistory           ProductStatusHistory[]
  productViews            ProductView[]
  favorites               Favorite[]
  wishlists               Wishlist[]
  recentSearches          RecentSearch[]
  recentlyViewed          RecentlyViewed[]
  searchLogs              SearchLog[]
  buyerConversations      Conversation[]            @relation("BuyerConversations")
  sellerConversations     Conversation[]            @relation("SellerConversations")
  messages                Message[]
  blockedUsers            BlockedUser[]             @relation("Blocker")
  blockedBy               BlockedUser[]             @relation("Blocked")
  presence                UserPresence?
  payments                Payment[]
  subscriptions           Subscription[]
  userSubscription        UserSubscription?
  boosts                  UserBoost[]
  couponRedemptions       CouponRedemption[]
  paymentAuditLogs        PaymentAuditLog[]
  refundsCreated          Refund[]                  @relation("AdminRefunds")
  reportsFiled            Report[]                  @relation("ReporterUser")
  assignedCases           ModerationCase[]          @relation("ModeratorUser")
  caseAssignments         CaseAssignment[]          @relation("CaseModerator")
  caseAssignmentsBy       CaseAssignment[]          @relation("CaseAssigner")
  warningsReceived        WarningHistory[]          @relation("UserWarnings")
  warningsCreated         WarningHistory[]          @relation("AdminWarnings")
  strikesReceived         UserStrike[]              @relation("UserStrikes")
  actionsExecuted         ModerationAction[]        @relation("ModeratorActions")
  notesWritten            ModerationNote[]          @relation("ModeratorNotes")
  blockedItems            BlockedContent[]          @relation("BlockedByAdmin")
  reviewsWritten          Review[]                  @relation("ReviewsWritten")
  reviewsReceived         Review[]                  @relation("ReviewsReceived")
  reviewReactions         ReviewReaction[]
  sellerStatistics        SellerStatistics?         @relation("SellerStats")
  buyerStatistics         BuyerStatistics?          @relation("BuyerStats")
  reputationScore         ReputationScore?          @relation("ReputationScore")
  trustScore              TrustScore?               @relation("TrustScore")
  sellerProfile           SellerProfile?
  buyerOrders             Order[]                   @relation("BuyerOrders")
  sellerOrders            Order[]                   @relation("SellerOrders")

  // Admin Module Relations
  adminSessions           AdminSession[]            @relation("AdminSessions")
  adminNotifications      AdminNotification[]       @relation("AdminNotifications")
  announcementsCreated    SystemAnnouncement[]      @relation("AnnouncementsCreated")

  @@index([email])
  @@index([phone])
  @@index([provider, providerId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g. CUSTOMER, MODERATOR, ADMIN, SUPER_ADMIN
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  token           String    @unique // Hashed refresh token
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?   // Replaced by token string/id for rotation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  token      String    @unique // Secure verification token
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique // Secure reset token
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model PhoneOtp {
  id         String    @id @default(uuid()) @db.Uuid
  otp        String    // Hashed OTP
  phone      String
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([phone])
  @@map("phone_otps")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Profile {
  id                          String    @id @default(uuid()) @db.Uuid
  userId                      String    @unique @db.Uuid
  firstName                   String?
  lastName                    String?
  displayName                 String?
  bio                         String?
  email                       String?
  phone                       String?
  dateOfBirth                 DateTime?
  gender                      String?
  country                     String?
  state                       String?
  city                        String?
  zipCode                     String?
  preferredLanguage           String?   @default("en")
  timezone                    String?   @default("UTC")
  profileImageId              String?   @db.Uuid
  coverImageId                String?   @db.Uuid
  website                     String?
  socialLinks                 Json?
  lastLogin                   DateTime?
  profileCompletionPercentage Int       @default(0)
  verifiedBadge               Boolean   @default(false)
  status                      String    @default("ACTIVE")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?
  createdBy                   String?
  updatedBy                   String?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImage MediaFile? @relation("ProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  coverImage   MediaFile? @relation("CoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("profiles")
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  type         AddressType @default(HOME)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g. users.view
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model NotificationSetting {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid
  emailNotifications   Boolean   @default(true)
  smsNotifications     Boolean   @default(true)
  pushNotifications    Boolean   @default(true)
  marketingEmails      Boolean   @default(false)
  chatNotifications    Boolean   @default(true)
  orderNotifications   Boolean   @default(true)
  listingNotifications Boolean   @default(true)
  securityAlerts       Boolean   @default(true)
  newsletter           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_settings")
}

enum KycDocumentType {
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  PAN
  AADHAAR
}

enum KycStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model KycDocument {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  documentType   KycDocumentType
  documentNumber String
  frontImageId   String          @db.Uuid
  backImageId    String?         @db.Uuid
  selfieImageId  String          @db.Uuid
  status         KycStatus       @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  reviewedBy     String?         @db.Uuid
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  frontImage MediaFile  @relation("KycFront", fields: [frontImageId], references: [id], onDelete: Cascade)
  backImage  MediaFile? @relation("KycBack", fields: [backImageId], references: [id], onDelete: SetNull)
  selfieImage MediaFile @relation("KycSelfie", fields: [selfieImageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  oldValues Json?
  newValues Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model MediaFile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  category     String // e.g. "PROFILE_IMAGE", "COVER_IMAGE", "KYC_FRONT", "KYC_BACK", "KYC_SELFIE"
  thumbnailUrl String?
  status       String    @default("PENDING") // PENDING, PROCESSING, READY, FAILED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImages Profile[]     @relation("ProfileImage")
  coverImages   Profile[]     @relation("CoverImage")
  kycFronts     KycDocument[] @relation("KycFront")
  kycBacks      KycDocument[] @relation("KycBack")
  kycSelfies    KycDocument[] @relation("KycSelfie")

  @@index([userId])
  @@map("media_files")
}

enum AttributeType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  TIME
  EMAIL
  PHONE
  URL
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  COLOR
  FILE
  IMAGE
  JSON
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  description    String?
  parentId       String?   @db.Uuid
  level          Int       @default(0)
  sortOrder      Int       @default(0)
  icon           String?
  bannerImage    String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryToCategory")

  attributes        CategoryAttribute[]
  attributeGroups   CategoryAttributeGroup[]
  translations      CategoryTranslation[]
  products          Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model CategoryAttributeGroup {
  id         String    @id @default(uuid()) @db.Uuid
  categoryId String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributes CategoryAttribute[]

  @@index([categoryId])
  @@map("category_attribute_groups")
}

model CategoryAttribute {
  id           String        @id @default(uuid()) @db.Uuid
  categoryId   String        @db.Uuid
  groupId      String?       @db.Uuid
  name         String
  slug         String        // Attribute key (e.g. brand, model)
  type         AttributeType
  isRequired   Boolean       @default(false)
  minLength    Int?
  maxLength    Int?
  minValue     Float?
  maxValue     Float?
  regex        String?
  isUnique     Boolean       @default(false)
  placeholder  String?
  helpText     String?
  defaultValue String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  category     Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group        CategoryAttributeGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  options      AttributeOption[]
  values       CategoryAttributeValue[]
  productAttributes ProductAttribute[]

  @@index([categoryId])
  @@index([groupId])
  @@map("category_attributes")
}

model AttributeOption {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @db.Uuid
  value       String
  label       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@map("attribute_options")
}

model CategoryAttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  listingId   String   @db.Uuid
  attributeId String   @db.Uuid
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute   CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([attributeId])
  @@map("category_attribute_values")
}

model CategoryTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @db.Uuid
  locale         String
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@map("category_translations")
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  ARCHIVED
  PAUSED
  SOLD
  UNDER_REVIEW
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @db.Uuid
  categoryId      String           @db.Uuid
  subcategoryId   String?          @db.Uuid
  title           String
  slug            String           @unique
  description     String
  condition       ProductCondition
  price           Float            // Using Float for ease of calculations in JS
  currency        String           @default("INR")
  negotiable      Boolean          @default(false)
  quantity        Int              @default(1)
  status          ProductStatus    @default(DRAFT)
  rejectionReason String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  featuredUntil   DateTime?
  boostUntil      DateTime?
  viewCount       Int              @default(0)
  favoriteCount   Int              @default(0)
  chatCount       Int              @default(0)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  attributes    ProductAttribute[]
  images        ProductImage[]
  videos        ProductVideo[]
  location      ProductLocation?
  statusHistory ProductStatusHistory[]
  featuredAds   FeaturedProduct[]
  boostedAds    BoostedProduct[]
  views         ProductView[]
  statistics    ProductStatistics?
  favorites     Favorite[]
  wishlistItems WishlistItem[]
  recentlyViewed RecentlyViewed[]
  conversations  Conversation[]
  payments       Payment[]
  reviews        Review[]
  orders         Order[]


  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([slug])
  @@map("products")
}

model ProductAttribute {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  attributeId String   @db.Uuid
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([attributeId])
  @@map("product_attributes")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  originalUrl  String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  fileKey      String?  // S3 path for cleanup
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  originalUrl  String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  duration     Float?
  fileKey      String?  // S3 path for cleanup
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model ProductLocation {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @db.Uuid
  country   String
  state     String
  city      String
  area      String?
  zipCode   String?
  latitude  Float?
  longitude Float?
  geoHash   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_locations")
}

model ProductStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @db.Uuid
  fromStatus  ProductStatus
  toStatus    ProductStatus
  comment     String?
  changedById String?       @db.Uuid
  createdAt   DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_status_history")
}

model FeaturedProduct {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  packageId    String?
  durationDays Int
  startDate    DateTime @default(now())
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("featured_products")
}

model BoostedProduct {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  packageName String
  startDate   DateTime @default(now())
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("boosted_products")
}

model ProductView {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String?  @db.Uuid
  ipAddress String?
  userAgent String?
  viewedAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_views")
}

model ProductStatistics {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @unique @db.Uuid
  viewsTotal     Int      @default(0)
  viewsUnique    Int      @default(0)
  favoritesCount Int      @default(0)
  chatsCreated   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_statistics")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @default("Default Wishlist")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
