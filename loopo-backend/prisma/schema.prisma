// --- NEW SYSTEM & ADMIN MODELS (PHASE 11) ---

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  group       String   @default("GENERAL") // GENERAL, PAYMENT, REGISTRATION, EMAIL, SMS, PUSH, STORAGE
  isPublic    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.Uuid

  @@index([group])
  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.Uuid

  @@map("feature_flags")
}

enum BannerType {
  HOMEPAGE
  CATEGORY
  POPUP
  PROMOTIONAL
}

model Banner {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  type        BannerType @default(HOMEPAGE)
  imageUrl    String
  targetUrl   String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  startDate   DateTime?
  endDate     DateTime?
  audience    String?    // ALL, LOGGED_IN, GUEST
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  createdBy   String?    @db.Uuid
  updatedBy   String?    @db.Uuid

  @@index([type])
  @@index([isActive])
  @@map("banners")
}

model CmsPage {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  slug            String   @unique
  content         String   @db.Text
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?  @db.Uuid
  updatedBy       String?  @db.Uuid

  @@index([slug])
  @@map("cms_pages")
}

model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  ipAddress String?
  userAgent String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revokedAt DateTime?

  user      User     @relation("AdminSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("admin_sessions")
}

model AdminNotification {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  message     String
  type        String   @default("SYSTEM") // SYSTEM, ALERT, REPORT, KYC
  isRead      Boolean  @default(false)
  targetUserId String? @db.Uuid // If null, broadcasts to all admins
  actionUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targetUser  User?    @relation("AdminNotifications", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([isRead])
  @@map("admin_notifications")
}

model SystemAnnouncement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  message     String   @db.Text
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  targetRole  String?  // ALL, CUSTOMER, SELLER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdBy   String?  @db.Uuid

  creator     User?    @relation("AnnouncementsCreated", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("system_announcements")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model SellerProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  displayName         String
  storeName           String?
  bio                 String?
  profileImage        String?
  verificationStatus  String           @default("PENDING") // PENDING, VERIFIED, SUSPENDED
  kycStatus           KycStatus        @default(DRAFT)
  trustScore          Float            @default(50.0)
  sellerRating        Float            @default(0.0)
  totalSales          Int              @default(0)
  totalListings       Int              @default(0)
  responseRate        Float            @default(0.0)
  averageResponseTime Float            @default(0.0) // in seconds
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  buyerId      String      @db.Uuid
  sellerId     String      @db.Uuid
  productId    String      @db.Uuid
  quantity     Int         @default(1)
  price        Float
  totalAmount  Float
  currency     String      @default("INR")
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  buyer        User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller       User        @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("orders")
}
