  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

model UserPresence {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  isOnline   Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
