model TrustScore {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  score                 Float    @default(50)
  averageRatingFactor   Float    @default(0)
  transactionFactor     Float    @default(0)
  cancellationPenalty   Float    @default(0)
  reportPenalty         Float    @default(0)
  accountAgeFactor      Float    @default(0)
  kycBonus              Float    @default(0)
  responseTimeFactor    Float    @default(0)
  strikePenalty         Float    @default(0)
  updatedAt             DateTime @updatedAt

  user                  User     @relation("TrustScore", fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_scores")
}

